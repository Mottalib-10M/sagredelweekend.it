---
/** Pages à intégrer (iframe) : un outil seul, en italien et en anglais. noindex, hors sitemap (astro.config). */
import '../../../styles/global.css';
import Tool from '../../../components/Tool.astro';
import { SITE_URL, SITE_NAMES, LANG_TAGS } from '../../../data/site-config';
import { route } from '../../../i18n/routes';
import { t as ui } from '../../../i18n/ui';
type Lang = 'it' | 'en';
const EMBEDS = {
  sagre: { kind: 'trova', page: 'home', t: { it: 'Sagre del weekend', en: 'Sagre this weekend' } },
  mercatini: { kind: 'aperto', page: 'natale-aperto', t: { it: 'Il mercatino di Natale è aperto?', en: 'Is the Christmas market open?' } },
} as const;
export function getStaticPaths() {
  return (['it', 'en'] as const).flatMap((lang) => ['sagre', 'mercatini'].map((name) => ({ params: { lang, name } })));
}
const { lang, name } = Astro.params as { lang: Lang; name: keyof typeof EMBEDS };
const e = EMBEDS[name];
const page = `${SITE_URL}${route(e.page, lang)}`;
const note = { it: 'La ricerca resta sul tuo dispositivo · strumento di Radif Partners, non un servizio pubblico', en: 'Your search stays on your device · tool by Radif Partners, not a government service' }[lang];
---
<!doctype html>
<html lang={LANG_TAGS[lang]}>
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{`${e.t[lang]} (${lang === 'it' ? 'da incorporare' : 'embed'})`}</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={page} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
  </head>
  <body class="bg-white p-2 text-navy-900">
    <main><Tool kind={e.kind} lang={lang} idPrefix="embed" /></main>
    <p class="mt-2 text-center text-xs text-navy-600"><a href={page} target="_blank" rel="noopener" class="underline">{SITE_NAMES[lang]}</a> · {note}</p>
    <p class="mt-1 text-center text-xs text-navy-500" set:html={ui(lang).footerLicence} />
  </body>
</html>
