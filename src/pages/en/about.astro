---
import PageLayout from '../../layouts/PageLayout.astro';
import LegalIdentity from '../../components/LegalIdentity.astro';
import { route } from '../../i18n/routes';
import { AUTHOR_NAME, AUTHOR_DESC, CONTACT_EMAIL } from '../../data/site-config';
import { srcLink } from '../../lib/helpers';
import { KIT as K } from '../../lib/kit';
import { profilePageSchema, breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const path = route('about', lang);
const title = 'Who publishes this Italian sagre calendar, and its data';
const description = 'Who publishes Sagre del Weekend: Radif Partners, an independent publisher with no tickets or listings to sell, and where its sagre and markets come from.';
const s = (k: string, t: string) => srcLink(k, lang, t);
---
<PageLayout title={title} description={description} lang={lang} jsonLd={[profilePageSchema({ path, lang }), breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'About', path }])]} breadcrumbs={[{ label: 'About' }]}>
  <article class="prose prose-slate max-w-none">
    <h1>About</h1>
    <p>{AUTHOR_DESC.en}</p>
    <h2>Why this site exists</h2>
    <p>On a Friday evening you look for a sagra for Sunday and find lists copied from one year to the next, events that are already over and pages full of adverts. Meanwhile Italian regions publish official calendars that hardly anyone reads, because they are files to download. Here those files become a search: pick the weekend and the area, and see what is on, with the source of every line.</p>
    <h2>Who publishes it</h2>
    <p>The publisher is {AUTHOR_NAME}, a company that builds tools from public data. {AUTHOR_NAME} is not a municipality, a Pro Loco or a tourist board, has no link with the regions and uses no emblems or logos. The site sells no tickets or listings and takes no money to feature a sagra.</p>
    <LegalIdentity lang={lang} />
    <h2>Where the data come from</h2>
    <p>From the <Fragment set:html={s('lom', 'Lombardy Region')} /> (CC0), the <Fragment set:html={s('odh', 'South Tyrol Open Data Hub')} /> (CC0), <Fragment set:html={s('er', 'Emilia-Romagna’s event list')} /> and the <Fragment set:html={s('pug', '“Cosa fare in Puglia”')} /> file (CC BY 4.0). Last read: {K.dl(K.LETTO_IL, lang, false)}. How we filter them is explained in the <a href={route('method', lang)}>method</a>.</p>
    <h2>Your data</h2>
    <p>The search runs in your browser. The town you pick and your location, if you share it, are neither sent nor stored. Details are in the <a href={route('privacy', lang)}>privacy policy</a>.</p>
    <h2>What the site does not do</h2>
    <p>It does not organise sagre and cannot confirm that one actually takes place: if the weather turns or the town cancels, only the Pro Loco knows. It does not cover regions that publish no open calendar.</p>
    <h2>Write to us</h2>
    <p><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a> if a date or a place looks wrong.</p>
  </article>
</PageLayout>
