---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'it';
const code = (name: string, t: string, h: number) => `<iframe src="${SITE_URL}/embed/${lang}/${name}/" title="${t}" width="100%" height="${h}" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
const items = [
  { name: 'sagre', h2: 'Sagre del weekend', text: 'Regione o città, periodo e tipo di evento: i tuoi lettori vedono le sagre, le fiere e le feste dei calendari regionali.', t: 'Sagre del weekend', h: 900 },
  { name: 'mercatini', h2: 'Il mercatino è aperto?', text: 'Un mercatino di Natale e un giorno: aperto o chiuso, e fra quanti giorni apre o chiude.', t: 'Mercatino di Natale aperto', h: 520 },
];
---
<PageLayout title="Sagre e mercatini da incorporare gratis nel tuo sito" description="La ricerca delle sagre del weekend e lo strumento dei mercatini di Natale aperti, da incorporare gratis con un iframe: copi il codice una volta, i dati restano quelli regionali." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Widget', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Widget' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Incorpora la ricerca delle sagre</h1>
    <p class="mt-3 text-lg text-navy-700">Per Pro Loco, giornali locali e uffici turistici: copi il codice una volta, ogni nuova lettura dei file regionali arriva da sola.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    {items.map((i) => (<>
      <h2>{i.h2}</h2>
      <p>{i.text}</p>
      <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code(i.name, i.t, i.h)}</code></pre>
    </>))}
    <p>Per la versione inglese sostituisci <code>/embed/it/</code> con <code>/embed/en/</code>. Condizioni: il link alla fonte e la riga delle licenze sotto lo strumento restano visibili, lo strumento non viene modificato ed è fornito senza garanzia. Domande dalla pagina <a href={route('contact', lang)}>contatti</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src={`/embed/${lang}/sagre/`} title="Sagre del weekend" width="100%" height="900" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
