---
/** Le corps HTML d'un fichier de contenu, ses mini-simulateurs rendus en îlots. */
import MiniSim from './calc/MiniSim';
import { miniHref } from '../lib/mini-targets';
import type { Lang } from '../lib/format';
interface Props { html: string; path: string; lang: Lang }
const { html, path, lang } = Astro.props;
const parts = html.split(/<!--mini:([A-Za-z0-9_]+)(?:\|([A-Za-z0-9+/=]+))?-->/);
const decode = (b?: string) => (b ? JSON.parse(Buffer.from(b, 'base64').toString('utf8')) as { t?: string; d?: Record<string, number>; locked?: string[] } : {});
let k = 0;
---
<div class="prose prose-slate max-w-none">
  {parts.map((p, i) => {
    if (i % 3 === 0) return <Fragment set:html={p ?? ''} />;
    if (i % 3 === 2) return null;
    const o = decode(parts[i + 1]);
    k++;
    return <div data-chrome class="not-prose"><MiniSim client:load kind={p} lang={lang} title={o.t} defaults={o.d} locked={o.locked} idPrefix={`m${k}`} href={miniHref(p, lang, path)} /></div>;
  })}
</div>
