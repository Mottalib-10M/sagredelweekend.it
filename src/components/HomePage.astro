---
/**
 * Accueil : le moteur de recherche (ce week-end), quatre repères, la réponse repliée, l'origine des dates avec
 * le tableau des régions, les familles de pages, les textes longs en accordéons, la FAQ. Texte : src/content/home.ts.
 */
import PageLayout from '../layouts/PageLayout.astro';
import Clamp from './Clamp.astro';
import Tool from './Tool.astro';
import Body from './Body.astro';
import { HOME, HOME_SOURCES, nNatHome } from '../content/home';
import { route, hasRoute, type Locale } from '../i18n/routes';
import { GROUPS, label } from '../i18n/nav';
import { helpers, sourceList } from '../lib/helpers';
import { PAGES } from '../lib/pages';
import { KIT as K } from '../lib/kit';
import { displayDate } from '../lib/format';
import { faqSchema, organizationSchema, websiteSchema, webPageSchema, webApplicationSchema } from '../lib/seo';
interface Props { lang: Locale }
const { lang } = Astro.props;
const x = HOME[lang];
const path = route('home', lang);
const h = helpers(lang);
const sources = sourceList(HOME_SOURCES, lang);
const jsonLd = [websiteSchema(lang), organizationSchema(lang), webPageSchema({ name: x.h1, description: x.description, path, lang }), webApplicationSchema({ name: x.h1, description: x.description, path, lang }), faqSchema(x.faqs, lang)];
// Repères : jamais le chiffre du week-end (l'outil juste au-dessus le donne, avec sa période) ; chaque chiffre a la
// période écrite à côté et vaut ce que l'outil montre pour les mêmes réglages (tests/coerenza.test.ts).
const DIC = K.intervallo('m2026-12', K.OGGI);
const NAT = K.intervallo('natale', K.OGGI);
const nDic = K.contaStrumento({ periodo: 'm2026-12' });
const facts = lang === 'it'
  ? [{ k: 'Regioni coperte', v: String(K.REGIONI.length) }, { k: `Eventi ${K.periodoParole(DIC.dal, DIC.al, 'it')}`, v: h.n(nDic) }, { k: `Mercatini di Natale ${K.periodoParole(NAT.dal, NAT.al, 'it')}`, v: h.n(nNatHome) }, { k: 'Calendario aggiornato il', v: h.dm(K.LETTO_IL) }]
  : [{ k: 'Regions covered', v: String(K.REGIONI.length) }, { k: `Events ${K.periodoParole(DIC.dal, DIC.al, 'en')}`, v: h.n(nDic) }, { k: `Christmas markets ${K.periodoParole(NAT.dal, NAT.al, 'en')}`, v: h.n(nNatHome) }, { k: 'Calendar updated on', v: h.dm(K.LETTO_IL) }];
const vicino = { it: ['Cerca intorno alla tua città: sagre vicino a me', 'Il mercatino è aperto oggi?'], en: ['Search around your town: sagre near me', 'Is the market open today?'] }[lang];
const who = { it: 'Chi pubblica il sito', en: 'Who runs this site' }[lang];
const how = { it: 'Metodo e fonti', en: 'Method and sources' }[lang];
---
<PageLayout title={x.title} description={x.description} lang={lang} jsonLd={jsonLd} faqs={x.faqs} sources={sources} faqOuverte={0}>
  <header class="mb-4">
    <h1 class="text-[1.7rem] font-bold text-navy-900 max-sm:leading-tight sm:text-3xl md:text-4xl">{x.h1}</h1>
    <p class="mt-2 text-base text-navy-700 sm:text-lg">{x.intro}</p>
  </header>
  <div data-chrome><Tool kind="trova" lang={lang} preset={{ periodo: 'weekend' }} idPrefix="home" /></div>
  <p data-chrome class="mt-4 text-sm"><a href={route('vicino', lang)} class="font-medium text-accent-700 underline">{vicino[0]} →</a> · <a href={route('natale-aperto', lang)} class="font-medium text-accent-700 underline">{vicino[1]} →</a></p>
  <dl data-chrome class="limits my-6 text-sm">
    {facts.map((f) => <div><dt>{f.k}</dt><dd>{f.v}</dd></div>)}
  </dl>
  <Clamp text={x.resume} lang={lang} id="clamp-home" class="my-8" />
  <p class="text-sm text-navy-700"><a href={route('method', lang)} class="font-medium text-accent-700 underline">{how}</a> · <a href={route('about', lang)} class="font-medium text-accent-700 underline">{who}</a> · {lang === 'it' ? 'aggiornato il' : 'updated on'} <time datetime={K.LETTO_IL}>{displayDate(K.LETTO_IL, lang)}</time></p>
  <section class="mt-8"><Body html={x.why(h)} path={path} lang={lang} /></section>
  <section class="mt-10" data-chrome>
    <h2 class="text-2xl font-bold text-navy-900">{x.listsTitle}</h2>
    {GROUPS.map((g) => {
      const list = PAGES.filter((p) => p.group === g.id && hasRoute(p.id, lang));
      return list.length > 0 && (
        <div class="mt-5">
          <h3 class="text-lg font-bold text-navy-900">{g.label[lang]}</h3>
          <ul class="mt-2 grid gap-x-6 gap-y-2 text-sm sm:grid-cols-2 lg:grid-cols-3">
            {list.map((p) => <li><a href={route(p.id, lang)} class="font-medium text-accent-700 underline-offset-2 hover:underline">{label(p.id, lang)}</a><span class="block text-navy-600">{p[lang].card}</span></li>)}
          </ul>
        </div>
      );
    })}
  </section>
  <section class="mt-10">
    <h2 class="text-2xl font-bold text-navy-900">{x.foldTitle}</h2>
    {x.sections(h).map((s) => <details class="fold"><summary><h3 class="fold-h">{s.title}</h3></summary><div class="pb-4"><Body html={s.html} path={path} lang={lang} /></div></details>)}
  </section>
</PageLayout>
